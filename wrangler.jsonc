// Cloudflare Worker: serves the built PWA (web/dist) and the JSON API under /api/*, backed by D1.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marajeel",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marajeel",
      "database_id": "001f561e-a522-4805-a767-52d69ed5c201",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": { "enabled": true }
}
