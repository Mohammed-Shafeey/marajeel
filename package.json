{
  "name": "marajeel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,web -c blue,magenta \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:worker": "npm run db:migrate:local && wrangler dev --port 8787",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "typecheck": "tsc -p worker/tsconfig.json",
    "test": "vitest run --config worker/vitest.config.ts && npm --prefix web test",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed": "node scripts/seed.ts --local",
    "admin:add": "node scripts/admin.ts",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.10.0",
    "concurrently": "^9.2.5",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
